{
  "info": {
    "name": "pss-lab02-moje-testy",
    "description": null,
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "NBP — 3 ostatnie kursy",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "description": "",
            "disabled": false,
            "type": "default"
          },
          {
            "key": "Connection",
            "value": "close",
            "description": "",
            "disabled": false,
            "type": "default"
          }
        ],
        "description": "",
        "url": {
          "raw": "{{nbp_url}}/exchangerates/rates/a/{{currency_code}}/last/3/",
          "protocol": "",
          "host": [
            "{{nbp_url}}"
          ],
          "path": [
            "exchangerates",
            "rates",
            "a",
            "{{currency_code}}",
            "last",
            "3",
            ""
          ],
          "query": [],
          "variable": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "// Tests",
              "const json = pm.response.json();",
              "",
              "pm.test(\"Odpowiedź ma wymagane pola code i rates\", function() {",
              "  pm.expect(json).to.have.property(\"code\");",
              "  pm.expect(json).to.have.property(\"rates\");",
              "});",
              "",
              "pm.test(\"Kod waluty ma format trzech wielkich liter\", function() {",
              "  pm.expect(json.code).to.match(/^[A-Z]{3}$/);",
              "});",
              "",
              "pm.test(\"Tablica rates zawiera dokładnie 3 elementy\", function() {",
              "  pm.expect(json.rates).to.be.an(\"array\");",
              "  pm.expect(json.rates).to.have.lengthOf(3);",
              "});",
              "",
              "pm.test(\"Każdy kurs ma prawidłową datę i dodatni kurs\", function() {",
              "  json.rates.forEach(function(rate) {",
              "    pm.expect(rate).to.have.property(\"effectiveDate\");",
              "    pm.expect(rate).to.have.property(\"mid\");",
              "    pm.expect(rate.effectiveDate).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "    pm.expect(rate.mid).to.be.a(\"number\").and.above(0);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
