        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "// Tests",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Status odpowiedzi to 400\", function() {",
              "  pm.expect(pm.response.code).to.equal(400);",
              "});",
              "",
              "pm.test(\"Content-Type zawiera text/plain\", function() {",
              "  pm.expect(pm.response.headers.get(\"content-type\")).to.include(\"text/plain\");",
              "});",
              "",
              "pm.test(\"Komunikat zawiera limit 255\", function() {",
              "  pm.expect(body.toString()).to.include(\"255\");",
              "});"
            ]
          }
        }
      ]
    }
